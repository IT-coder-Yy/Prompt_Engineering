{
  "name": "prompt-learning-station",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "npm run typecheck && next build",
    "start": "next start",
    "lint": "eslint .",
